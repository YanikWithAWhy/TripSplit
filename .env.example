# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API / API Keys).
# Without these, the app saves everything in the browser only.
#
# The key is the publishable key (sb_publishable_…) or the legacy "anon" key.
# It is meant to be public: row level security protects the data.
# Never put the secret / service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
